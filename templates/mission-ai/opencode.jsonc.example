{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["azure", "amazon-bedrock", "opencode"],
  "share": "disabled",
  "provider": {
    "nasa_mission_ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NASA Mission AI LiteLLM",
      "options": {
        "baseURL": "https://proxy.fast.luna.nasa.gov"
      },
      "models": {
        "claude-opus-5-5": { "name": "Claude Opus 5.5", "limit": { "context": 1000000, "output": 128000 } },
        "claude-sonnet-5-5": { "name": "Claude Sonnet 5.5", "limit": { "context": 1000000, "output": 128000 } },
        "claude-haiku-5-5": { "name": "Claude Haiku 5.5", "limit": { "context": 1000000, "output": 128000 } },
        "gpt-6-astra": { "name": "GPT-6 Astra", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-6-sol": { "name": "GPT-6 Sol", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-6-luna": { "name": "GPT-6 Luna", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-6.1-sol": { "name": "GPT-6.1 Sol", "limit": { "context": 1131072, "output": 131072 } },
        "gpt-5.6-sol": { "name": "GPT-5.6 Sol", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-5.6-terra": { "name": "GPT-5.6 Terra", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna", "limit": { "context": 1050000, "output": 128000 } },
        "gemini-4-argon": { "name": "Gemini 4 Argon" },
        "gemini-3.8-flash": { "name": "Gemini 3.8 Flash", "limit": { "context": 1048576, "output": 65536 } }
      }
    }
  }
}
