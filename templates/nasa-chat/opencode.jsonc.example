{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers":
   [
      "azure",
      "amazon-bedrock",
      "opencode"
   ],
  "share": "disabled",
  "provider": {
    "nasa_chat_anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "NASA Chat (Anthropic)",
      "options": {
        "baseURL": "https://api.asksage.ai.nasa.gov/server/anthropic/v1"
      },
      "models": {
        "claude-opus-5-5-gov": { "name": "Claude Opus 5.5" },
        "claude-sonnet-5-5-gov": { "name": "Claude Sonnet 5.5" },
        "claude-haiku-4-5": { "name": "Claude Haiku 4.5" }
      }
    },
    "nasa_chat_openai": {
      "npm": "@ai-sdk/openai",
      "name": "NASA Chat (OpenAI)",
      "options": {
        "baseURL": "https://api.asksage.ai.nasa.gov/server/openai/v1"
      },
      "models": {
        "gpt-5.6-sol": { "name": "GPT-5.6 Sol" },
        "gpt-5.6-terra": { "name": "GPT-5.6 Terra" },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna" }
      }
    },
    "nasa_chat_grok": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NASA Chat (xAI)",
      "options": {
        "baseURL": "https://api.asksage.ai.nasa.gov/server/openai/v1"
      },
      "models": {
        "aws-bedrock-grok-4-3-gov": { "name": "Grok 4.3 Gov (OpenAI-Compatible)" }
      }
    },
    "nasa_chat_google": {
      "npm": "@ai-sdk/google",
      "name": "NASA Chat (Google Gemini)",
      "options": {
        "baseURL": "https://api.asksage.ai.nasa.gov/server/google/v1beta",
        // Ask Sage requires the x-access-tokens header; the Google SDK's default
        // x-goog-api-key header alone does not authenticate to Ask Sage.
        "apiKey": "{env:NASA_CHAT_API_KEY}",
        "headers": {
          "x-access-tokens": "{env:NASA_CHAT_API_KEY}"
        }
      },
      "models": {
        "google-gemini-4-argon": { "name": "Gemini 4 Argon" },
        "google-gemini-3.8-flash": { "name": "Gemini 3.8 Flash" }
      }
    }
  }
}
