{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "policies": [
    { "action": "provider.use", "resource": "opencode", "effect": "deny" },
    { "action": "provider.use", "resource": "azure", "effect": "deny" },
    { "action": "provider.use", "resource": "amazon-bedrock", "effect": "deny" }
  ],
  "providers": {
    "nasa_chat_anthropic": {
      "name": "NASA Chat (Anthropic)",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "https://api.asksage.ai.nasa.gov/server/anthropic/v1",
        "apiKey": "{env:NASA_CHAT_API_KEY}"
      },
      "models": {
        "claude-opus-5.5": { "name": "Claude Opus 5.5", "compatibility": { "cacheFormat": "anthropic" } },
        "claude-sonnet-5.5": { "name": "Claude Sonnet 5.5", "compatibility": { "cacheFormat": "anthropic" } },
        "claude-haiku-4.5": { "name": "Claude Haiku 4.5", "compatibility": { "cacheFormat": "anthropic" } }
      }
    },
    "nasa_chat_openai": {
      "name": "NASA Chat (OpenAI)",
      "package": "@opencode/ai/providers/openai",
      "settings": {
        "baseURL": "https://api.asksage.ai.nasa.gov/server/openai/v1",
        "apiKey": "{env:NASA_CHAT_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": { "name": "GPT-5.6 Sol" },
        "gpt-5.6-terra": { "name": "GPT-5.6 Terra" },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna" }
      }
    },
    "nasa_chat_grok": {
      "name": "NASA Chat (xAI)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.asksage.ai.nasa.gov/server/openai/v1",
        "apiKey": "{env:NASA_CHAT_API_KEY}"
      },
      "models": {
        "aws-bedrock-grok-4-3-gov": {
          "name": "Grok 4.3 Gov (OpenAI-Compatible)"
        }
      }
    },
    "nasa_chat_google": {
      "name": "NASA Chat (Google Gemini)",
      "package": "@opencode/ai/providers/google",
      "settings": {
        "baseURL": "https://api.asksage.ai.nasa.gov/server/google/v1beta",
        // Ask Sage requires the x-access-tokens header; the Google SDK's default
        // x-goog-api-key header alone does not authenticate to Ask Sage.
        "apiKey": "{env:NASA_CHAT_API_KEY}"
      },
      "headers": {
        "x-access-tokens": "{env:NASA_CHAT_API_KEY}"
      },
      "models": {
        "google-gemini-3.7-flash": { "name": "Gemini 3.7 Flash (Ask Sage)" }
      }
    }
  }
}
